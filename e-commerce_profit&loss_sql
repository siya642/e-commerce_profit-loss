#Find the total sales for each region.
SELECT 
    region, SUM(sales) AS total_sales
FROM
    ecommerce.ecommerce_sales_data
GROUP BY region
ORDER BY total_sales DESC;


#Find the total profit for each region.
SELECT 
    region, SUM(profit) AS total_profit
FROM
    ecommerce.ecommerce_sales_data
GROUP BY region
ORDER BY total_profit DESC;


#Find total sales and profit for each category.
SELECT 
    category,
    SUM(profit) AS total_profit,
    SUM(sales) AS total_sales
FROM
    ecommerce.ecommerce_sales_data
GROUP BY category
ORDER BY total_sales , total_profit DESC;


#Find the total quantity sold for each region.
SELECT 
    region, SUM(quantity) AS total_quantity
FROM
    ecommerce.ecommerce_sales_data
GROUP BY region
ORDER BY total_quantity DESC;


#Find the number of order in each region.
SELECT 
    region, COUNT(*) AS number_of_order
FROM
    ecommerce.ecommerce_sales_data
GROUP BY region
ORDER BY number_of_order DESC;


#Find the average sales for each category.
SELECT 
    category, AVG(sales) AS avg_sales
FROM
    ecommerce.ecommerce_sales_data
GROUP BY category
ORDER BY avg_sales DESC;


#Find the average profit for each region.
SELECT 
    region, ROUND(AVG(profit), 2) AS avg_profit
FROM
    ecommerce.ecommerce_sales_data
GROUP BY region
ORDER BY avg_profit DESC;


#Find region where total sales are greater then the average region sales.
SELECT 
    region, SUM(sales) AS total_sales
FROM
    ecommerce.ecommerce_sales_data
GROUP BY region
HAVING SUM(sales) > (SELECT 
        AVG(regional_sales)
    FROM
        (SELECT 
            SUM(sales) AS regional_sales
        FROM
            ecommerce.ecommerce_sales_data
        GROUP BY region) AS region_totals);


#Find category where total profit is greater than 1,00,000.
SELECT 
    category, SUM(profit) AS total_profit
FROM
    ecommerce.ecommerce_sales_data
WHERE
    category < 100000
GROUP BY category;


#Find top 10 product base on total sales.
SELECT 
    productname, SUM(sales) AS total_sales
FROM
    ecommerce.ecommerce_sales_data
GROUP BY productname
ORDER BY total_sales DESC
LIMIT 10;


#Find the top 5 product based on total profit.
SELECT 
    productname, SUM(profit) AS total_profit
FROM
    ecommerce.ecommerce_sales_data
GROUP BY productname
ORDER BY total_profit DESC
LIMIT 5;


#Find the region with the highest total sales.
SELECT 
    region, SUM(sales) AS total_sales
FROM
    ecommerce.ecommerce_sales_data
GROUP BY region
ORDER BY total_sales DESC
LIMIT 1;


#Find the region with the highest total profit.
SELECT 
    region, SUM(profit) AS total_profit
FROM
    ecommerce.ecommerce_sales_data
GROUP BY region
ORDER BY total_profit DESC
LIMIT 1;


#Find the product with the highest quantity sold.
SELECT 
    productname, SUM(quantity) AS quantity_sold
FROM
    ecommerce.ecommerce_sales_data
GROUP BY Productname
ORDER BY quantity_sold DESC
LIMIT 1;


#Find total sales by year.
SELECT 
    YEAR(STR_TO_DATE(Order_Date, '%d-%m-%Y')) AS year,
    SUM(Sales) AS total_sales
FROM
    ecommerce.ecommerce_sales_data
GROUP BY YEAR(STR_TO_DATE(Order_Date, '%d-%m-%Y'))
ORDER BY year DESC;


#Find total profit by year.
SELECT 
    YEAR(STR_TO_DATE(order_date, '%d-%m-%y')) AS year,
    SUM(profit) AS total_profit
FROM
    ecommerce.ecommerce_sales_data
GROUP BY year
ORDER BY year DESC;


#Find the year with highest sales.
SELECT 
    YEAR(STR_TO_DATE(order_date, '%d-%m-%y')) AS year,
    SUM(sales) AS total_sale
FROM
    ecommerce.ecommerce_sales_data
GROUP BY year
ORDER BY year DESC
LIMIT 1;


#Find the year with highest profit.
SELECT 
    YEAR(STR_TO_DATE(order_date, '%d-%m-%y')) AS year,
    SUM(profit) AS total_profit
FROM
    ecommerce.ecommerce_sales_data
GROUP BY year
ORDER BY year DESC
LIMIT 1;


#Find month sales performance.
SELECT 
    MONTH(STR_TO_DATE(order_date, '%d-%m-%y')) AS month,
    SUM(sales) AS total_sales
FROM
    ecommerce.ecommerce_sales_data
GROUP BY month
ORDER BY month;


#Calculate the profit percentage for each order using.
SELECT 
    productname,
    profit,
    sales,
    (profit / sales) * 100 AS profit_percentage
FROM
    ecommerce.ecommerce_sales_data;


#Ranked all product based on total sales using rank().
select productname, sum(sales) as total_sales,
rank()
over(order by sum(sales) desc)
as ranked_sales
from ecommerce.ecommerce_sales_data
group by productname;


#Rank all region based on total profit using dense rank().
select region, sum(profit) as total_profit, 
dense_rank()
over(order by sum(profit) desc)
as ranked_profit
from ecommerce.ecommerce_sales_data
group by region;


#Find the top 3 product with the cheapest sale in each category.
SELECT *
from(select productname,category,sales,
rank()
over(partition by category 
		order by sales desc)
as sales_rank
from ecommerce.ecommerce_sales_data
) as ranked
where sales_rank <= 3;


#Find the highest selling product in each region.
select * 
from(
select productname,region,sum(sales)as total_sales,
rank()
over (partition by region
order by sum(sales) asc)
 as selling_product
 from ecommerce.ecommerce_sales_data
 group by Productname,Region
)as ranked
where selling_product <= 1;


#Find the most profitable productin each category.
select *
from (
select productname,category,sum(profit) as total_profit,
rank()
over (partition by category
	order by sum(profit) desc)
    as profitable_product
    from ecommerce.ecommerce_sales_data
    group by productname,category
    )as racked
    where profitable_product <=1;
    
    
#Find product whose total sales are greater than the average product sale.
SELECT 
    productname, SUM(sales) AS total_sales
FROM
    ecommerce.ecommerce_sales_data
GROUP BY productname
HAVING SUM(sales) > (SELECT 
        AVG(total_sales)
    FROM
        (SELECT 
            SUM(sales) AS total_sales
        FROM
            ecommerce.ecommerce_sales_data
        GROUP BY productname) AS product_sales);


#Find the cumulative sales overtime using window function.
select order_date,sales,
sum(sales) OVER(
order by str_to_date(order_date,'%d-%m-%y')
)as cumulative_sales
from ecommerce.ecommerce_sales_data
order by str_to_date(order_date,'%d-%m-%y');


#Calculate running total of profit of region.
select order_date,profit,region,
sum(profit) over(
partition by region
order by str_to_date(order_date,'%d-%m-%y')
)running_profit
from ecommerce.ecommerce_sales_data
order by region,str_to_date(order_date,'%d-%m-%y');

